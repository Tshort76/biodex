<?xml version="1.0" encoding="utf-8"?>
<!-- The BioDex mark: a bird, an oak leaf and a butterfly around the dex ring, carved in
     walnut. The walnut is dark and was disappearing into a dark home screen, so the art is
     cut to a squircle slightly smaller than the launcher's mask and the white background
     shows around it as a thin edge (D35, revised by D37).

     The art itself carries the shape — `tools/icon/build_icon.py` clips it, and its comment
     holds the arithmetic. Insetting a square photograph instead, which is what this file
     did first, gives an edge thick at the corners and thin at the sides: a photo on a white
     tile rather than a bordered mark.

     No monochrome layer: a photographic mark cannot theme cleanly, so themed launchers fall
     back to this icon rather than showing a muddy silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_border" />
    <foreground android:drawable="@mipmap/ic_launcher_art" />
</adaptive-icon>
