<?xml version="1.0" encoding="utf-8"?>
<!-- The BioDex mark: a bird, an oak leaf and a butterfly around the dex ring,
     carved in walnut. The art is opaque and full-bleed in the foreground layer,
     composed so the emblem sits inside the 66dp safe zone; the background is a
     flat walnut tone that only shows if a launcher insets the foreground.
     No monochrome layer: a photographic mark cannot theme cleanly, so themed
     launchers fall back to this icon rather than showing a muddy silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_art" />
</adaptive-icon>
