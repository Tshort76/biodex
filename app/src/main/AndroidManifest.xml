<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Slice 6: the "is there a network" probe of ARCHITECTURE.md 5.3, which is what lets an
         un-cached reference image say "connect to load it" rather than "could not be loaded".
         A normal permission: granted at install, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M13/D58/D63: lets the app read a photo's GPS tags — through the Files picker (D58),
         and through the media-store original behind a gallery-picker id (D63). Asked for at
         runtime on the Files button and on the first gallery tap; a refusal costs only the
         location. The prompt Android shows for it is the full photos-and-videos one. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- D63: the photo-library permission (and Android 14's partial-access flavour), asked for
         on the first gallery tap. It is what lets the app read the media-store original behind
         a picker URI, which is the only copy that still carries the photo's GPS. The picker
         itself never needs it; the place does. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BioDex">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BioDex">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S01's share sheet: a ZIP in cacheDir/exports handed to another app as a
             content:// URI with a read grant. Android refuses to pass a file:// path
             between apps, so this provider is what makes "export" reach a file manager. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
